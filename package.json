{
  "name": "money-bot",
  "version": "1.0.0",
  "description": "WhatsApp Expense Tracker Bot",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist && rm -rf node_modules && pnpm install",
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "pnpm build && nodemon --watch src --ext ts --exec 'pnpm build && node dist/index.js'",
    "verify": "tsc",
    "lint": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "axios": "^1.3.5",
    "fs": "0.0.1-security",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.4",
    "whatsapp-web.js": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-define-config": "^2.1.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.3"
  }
}
